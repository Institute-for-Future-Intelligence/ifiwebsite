{
  "hosting": {
    "public": "public",
    "predeploy": ["node scripts/stamp-dates.js"],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.exe",
      "**/*.dll",
      "**/*.msi",
      "**/*.apk",
      "**/*.jar",
      "**/*.dmg",
      "**/*.deb",
      "**/*.rpm",
      "**/*.bin"
    ],
    "redirects": [
      { "source": "/ie-privacy.html", "destination": "https://ie.intofuture.org/privacy", "type": 301 },
      { "source": "/ie-terms.html", "destination": "https://ie.intofuture.org/terms", "type": 301 }
    ],
    "headers": [
      {
        "source": "**/*.@(html|htm)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=600" }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot|mp4|mp3|pdf)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800" }
        ]
      }
    ]
  }
}
